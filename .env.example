# Paths to watch for file changes (comma-separated, relative or absolute)
WATCH_PATHS=./src

# --- Optional: SQL Database Schema Reader ---
# Set DB_TYPE to enable the get_schema MCP tool
# DB_TYPE=mssql | postgres | mysql

# MSSQL
# DB_TYPE=mssql
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_DATABASE=your_database
# MSSQL_USER=your_user
# MSSQL_PASSWORD=your_password

# PostgreSQL
# DB_TYPE=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=your_database
# PG_USER=your_user
# PG_PASSWORD=your_password

# MySQL / MariaDB
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=your_database
# MYSQL_USER=your_user
# MYSQL_PASSWORD=your_password

# Continuum SQLite DB location
DB_PATH=./knowledge.db

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Max files that can change simultaneously before ignoring as a bulk operation (e.g. git checkout)
BULK_TOUCH_THRESHOLD=30
